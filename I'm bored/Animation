import time

# shading levels --->  @ # 8 = - .

def pattern(type):

    if type == "zig zag":
        progress = 0
        num = 0
        dot = []
        while progress < 10000:
            if num >= 0:
                if len(dot) > 60:
                    dot.insert(0, "@")
                elif len(dot) > 40:
                    dot.insert(0, " ")
                elif len(dot) > 20:
                    dot.insert(0, "@")
                elif len(dot) >= 0:
                    dot.insert(0, " ")
            else:
                dot.remove(dot[0])

            
            if num >= 60:
                num = -60
            
            print(*dot)
            time.sleep(0.02)
            num += 5
            progress += 1
    
    if type == "diamond":
        progress = 0
        num = 0
        design = ["@" * 200]
        while progress < 10000:
            
            if num >= 1:
                num = -1
            elif num >= 0:
                design.insert(len(design)//2, " ")
            else:
                design.remove(design[len(design)//2])
            
            
            print(*design)
            time.sleep(0.02)
            num += 1
            progress += 1



pattern("zig zag")